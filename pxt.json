{
    "name": "bluemote",
    "version": "0.0.1",
    "description": "Receive BlueMote gamepad input over Bluetooth UART",
    "license": "MIT",
    "dependencies": {
        "core": "*",
        "bluetooth": "*"
    },
    "files": [
        "README.md",
        "bluemote.ts"
    ],
    "testFiles": [
        "test.ts"
    ],
    "supportedTargets": [
        "microbit"
    ],
    "disablesVariants": [
        "mbdal"
    ],
    "preferredEditor": "blocksprj",
    "yotta": {
        "config": {
            "microbit-dal": {
                "bluetooth": {
                    "open": 1,
                    "whitelist": 0,
                    "security_level": null,
                    "pairing_mode": 0,
                    "dfu_service": 0,
                    "event_service": 0,
                    "device_info_service": 0,
                    "eddystone_url": 0,
                    "eddystone_uid": 0,
                    "partial_flashing": 0
                },
                "gatt_table_size": "0x400"
            }
        }
    }
}
